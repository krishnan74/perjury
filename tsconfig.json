{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@perjury/tribunal": ["packages/tribunal/src/index.ts"],
      "@perjury/ens": ["packages/ens/src/index.ts"],
      "@perjury/graph-client": ["packages/graph-client/src/index.ts"],
      "@perjury/mcp-client": ["packages/mcp-client/src/index.ts"],
      "@perjury/llm": ["packages/llm/src/index.ts"],
      "@perjury/witness": ["agents/witness/src/index.ts"],
      "@perjury/claimant": ["agents/claimant/src/index.ts"],
      "@perjury/panel": ["agents/panel/src/index.ts"],
      "@perjury/shared": ["packages/shared/src/index.ts"],
      "@perjury/shared/pinned-deployments.json": ["packages/shared/src/pinned-deployments.json"],
      "@perjury/graph-guard": ["packages/graph-guard/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "agents/**/*.ts", "scripts/**/*.ts"],
  // cre/ compiles to a standalone WASM binary with its own dependency tree and
  // tsconfig — typecheck it with `bun run typecheck --cwd cre/tribunal`.
  "exclude": ["node_modules", "cre"]
}
