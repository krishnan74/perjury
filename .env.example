# Sepolia
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
OPERATOR_PRIVATE_KEY=
CLAIMANT_PK=
WITNESS_A_PK=
WITNESS_B_PK=

# The Graph — live Gateway. Mocked data disqualifies the track.
GRAPH_STUDIO_KEY=

# Chainlink VRF v2.5 (Sepolia). Fund the subscription with testnet LINK and add
# WitnessRoster as a consumer after deploying.
VRF_SUBSCRIPTION_ID=
VRF_COORDINATOR=
VRF_KEY_HASH=
VRF_CALLBACK_GAS_LIMIT=500000

# How long a verdict can be appealed before it settles. 120s for a demo; 3600 in production.
CHALLENGE_WINDOW_SECONDS=120

# ENSv2 hackathon deployment (NOT production ENS) — see packages/ens/src/deployment.ts
ENS_RESOLVER=0xf9de4979ddb290baf5b760d0e788125017bc33f6

# The addresses VerdictSink accepts reports from. Both immutable once deployed.
# Chainlink runs two Forwarders per chain for a tenant, and which one reports
# depends on how the workflow executed. Confirm yours with:
#   cre workflow supported-chains -T staging-settings -e .env
# Sepolia, as measured for this account:
#   DON deployment: 0xF8344CFd5c43616a4366C34E3EEE75af79a74482
#   CLI simulator:  0x15fC6ae953E024d975e77382eEeC56A9101f9F88
# The sink accepts either, so a failed DON deployment does not strand the demo.
# Leave the second unset to authorise only the first.
CRE_REPORT_WRITER=0xF8344CFd5c43616a4366C34E3EEE75af79a74482
CRE_ALT_REPORT_WRITER=0x15fC6ae953E024d975e77382eEeC56A9101f9F88

# CRE. Vault DON writes need beta access; simulation reads this locally instead.
PERJURY_COMMITMENT_SALT=

# Deployed Perjury contracts (fill after deploy)
CLAIM_REGISTRY_ADDRESS=
WITNESS_ROSTER_ADDRESS=
VERDICT_SINK_ADDRESS=
STANDING_WRITER_ADDRESS=

# ENS agent under test (scripts/prove-eac.ts)
AGENT_NAME=alice.perjury.eth
AGENT_NODE=
AGENT_RESOLVER=
AGENT_PK=

# Agents
ANTHROPIC_API_KEY=

# Lets a local agent run tell the DEPLOYED gateway where it published evidence.
# Without it a workflow running on the DON can only adjudicate claims whose URL
# happened to ship in the site's build. Generate any long random string and set
# the same value in the site's environment.
PERJURY_GATEWAY_TOKEN=
PERJURY_GATEWAY_PUBLISH_URL=https://perjury.vercel.app/api/evidence

# Which tribunal adjudicates a scene. Unset runs the CLI simulator locally; set
# to `don` to wait for the workflow deployed to the Chainlink DON instead.
# Running both races them: one report lands and the other reverts.
PERJURY_TRIBUNAL=
